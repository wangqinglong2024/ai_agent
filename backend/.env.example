# ============================================================================
# 后端环境变量 - 复制此文件为 .env 并填写实际值
# ============================================================================

# --- 运行环境 ---
ENV=development

# --- Supabase 配置 ---
# 后端容器通过 global-data-link 网络直达 Supabase Kong (Docker 内部通信)
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Dify 配置 ---
# Dify 在独立 Docker 网络，通过宿主机端口 9000 访问
DIFY_API_URL=http://host.docker.internal:9000/v1
DIFY_API_KEY=your-dify-app-api-key

# --- Openclaw 配置 ---
# Openclaw 运行在宿主机 (非 Docker)，通过 host.docker.internal 访问
OPENCLAW_API_URL=http://host.docker.internal:18789
OPENCLAW_API_KEY=your-openclaw-api-key

# --- CORS 配置 ---
# 允许的前端地址，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost
