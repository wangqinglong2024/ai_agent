# ============================================================================
# 后端环境变量 - 复制此文件为 .env 并填写实际值
# ============================================================================

# --- 运行环境 ---
ENV=production

# --- Supabase 配置 ---
# Docker 内部网络: http://supabase-kong:8000
# 本地开发: http://<你的服务器IP>:8000 或 http://supabase.ideas.top (取决于端口暴露方式)
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Dify 配置 ---
# Docker 内部网络: http://dify-api:5001/v1  (看你的 Dify docker-compose 中的服务名)
# 本地开发: http://<你的服务器IP>:<Dify端口>/v1
DIFY_API_URL=http://dify-api:5001/v1
DIFY_API_KEY=your-dify-app-api-key

# --- Openclaw 配置 ---
# Openclaw 运行在宿主机，Docker 内通过 host.docker.internal 访问
OPENCLAW_API_URL=http://host.docker.internal:3456
OPENCLAW_API_KEY=your-openclaw-api-key

# --- CORS 配置 ---
# 允许的前端域名，逗号分隔
CORS_ORIGINS=https://ideas.top,https://www.ideas.top,http://localhost:5173
