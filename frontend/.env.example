# ============================================================================
# 前端环境变量 - 复制此文件为 .env 并填写实际值
# Vite 要求前端环境变量必须以 VITE_ 开头
# ============================================================================

# --- Supabase 配置 ---
# 前端在浏览器中运行，必须使用公网可达的地址
# Supabase Kong API 网关映射到宿主机 8000 端口
# 将 YOUR_SERVER_IP 替换为你的腾讯云公网 IP (如 115.159.109.23)
VITE_SUPABASE_URL=http://YOUR_SERVER_IP:8000
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- 后端 API 地址 ---
# 开发环境: 留空 (Vite proxy 会自动代理 /api → localhost:8080)
# 生产环境: 留空 (Nginx 会代理 /api → backend:8080)
VITE_API_BASE_URL=
