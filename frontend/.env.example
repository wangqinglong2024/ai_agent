# ============================================================================
# 前端环境变量 - 复制此文件为 .env 并填写实际值
# Vite 要求前端环境变量必须以 VITE_ 开头
# ============================================================================

# --- Supabase 配置 ---
# 注意: 这是从浏览器访问的 URL，必须是公网可达的地址
# 如果你的 Supabase Kong 直接在 8000 端口暴露: http://<服务器IP>:8000
# 如果通过 Nginx 代理: 需要确保路径正确
VITE_SUPABASE_URL=http://supabase.ideas.top
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- 后端 API 地址 ---
# 本地开发: 留空 (Vite proxy 会自动代理 /api → localhost:8080)
# 生产环境: 留空 (Nginx 会代理 /api → backend:8080)
VITE_API_BASE_URL=
